# ── LLM provider (set ONE) ─────────────────────────────────────────────
# NVIDIA NIM
NVIDIA_API_KEY=
# or Anthropic
ANTHROPIC_API_KEY=
# or OpenAI / OpenAI-compatible endpoints
OPENAI_API_KEY=

# ── Optional overrides ─────────────────────────────────────────────────
# Model override (defaults: nvidia/llama-3.1-8b-instruct,
# claude-sonnet-4-20250514, or gpt-4o-mini depending on provider)
SICK_MODEL=
# Base URL for OpenAI-compatible custom endpoints
SICK_BASE_URL=
# Where experiences are stored (default: ~/.sick)
SICK_MEMORY_DIR=
# Where the remotion skills were installed (default: ~/.agents/skills)
SICK_REMOTION_DIR=
# Run bash inside a bwrap sandbox without the --sandbox flag ("1" to enable)
SICK_SANDBOX=